#!/bin/sh
# Onion Ports shortcut (Standalone Ports Script Template) for the KNL port.
GameName="Kingdom New Lands"
GameDir="KingdomNewLands"
GameExecutable="knl.sh"
# The launcher must run before owned data has been imported.
GameDataFile="knl.sh"
KillAudioserver=1
PerformanceMode=1
Arguments=""
/mnt/SDCARD/Emu/PORTS/launch_standalone.sh "$GameName" "$GameDir" "$GameExecutable" "$Arguments" "$GameDataFile" "$KillAudioserver" "$PerformanceMode"
